# The single front door. TLS is terminated here and everything is one origin, so the browser app
# needs no CORS and the identity provider, API and MCP server all share one public hostname.
#
# For localhost, Caddy issues a certificate from its own local CA (your browser will warn until you
# trust it). For a real hostname, set PUBLIC_HOST and Caddy gets a public certificate on its own.
{$PUBLIC_HOST:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# The identity provider's admin console and its "master" realm are the keys to every sign-in,
	# so they are not served to the internet. To manage users, set KEYCLOAK_EXPOSE_ADMIN=true in
	# .env (and turn it off again afterwards), or reach Keycloak from inside the private network.
	@keycloak_admin {
		path /auth/admin /auth/admin/* /auth/realms/master /auth/realms/master/*
		expression `'{$KEYCLOAK_EXPOSE_ADMIN:false}' != 'true'`
	}
	handle @keycloak_admin {
		respond "Not found" 404
	}

	# Identity provider (Keycloak lives under /auth).
	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	# OAuth clients find an authorization server whose address has a path (ours does, /auth/...)
	# at /.well-known/oauth-authorization-server/<path> (RFC 8414). Keycloak publishes the same
	# document under its own path, so pass these requests on to it.
	@as_metadata path_regexp as_metadata ^/\.well-known/(oauth-authorization-server|openid-configuration)/auth/realms/([^/]+)/?$
	handle @as_metadata {
		rewrite * /auth/realms/{re.as_metadata.2}/.well-known/{re.as_metadata.1}
		reverse_proxy keycloak:8080
	}

	# Admin API.
	handle /api/* {
		reverse_proxy gui-backend:8100
	}

	# MCP over Streamable HTTP, plus the OAuth discovery documents that clients look for.
	# flush_interval -1 sends server-sent events as they happen instead of buffering them.
	handle /mcp* {
		reverse_proxy mcp-server:8000 {
			flush_interval -1
		}
	}
	handle /.well-known/* {
		reverse_proxy mcp-server:8000
	}

	# Everything else is the admin console (a single-page app).
	handle {
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		header X-Frame-Options "DENY"
		reverse_proxy gui-frontend:8080
	}
}
