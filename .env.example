# Copy to .env and replace every "change-me" value. .env is git-ignored.
# These are LOCAL DEVELOPMENT settings; production secrets belong in a secrets manager.

# --- Postgres server (one container, two databases: app_meta and org_data) ---
POSTGRES_PORT=5432
# Bootstrap superuser. Only used by the init script on first start, never by the services.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Least-privilege roles created by db/init/01-create-roles-and-databases.sh
META_OWNER_PASSWORD=change-me    # owns app_meta, runs Alembic migrations
MCP_APP_PASSWORD=change-me       # mcp-server: reads config, appends to audit_log
GUI_APP_PASSWORD=change-me       # gui-backend: manages config, reads audit_log
ORG_OWNER_PASSWORD=change-me     # owns the sample org_data database (dev only)
ORG_READONLY_PASSWORD=change-me  # read-only role the MCP server uses on org_data

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- Alembic (run from the db/ folder) ---
# Must use the same password as META_OWNER_PASSWORD above.
APP_META_MIGRATIONS_URL=postgresql+asyncpg://meta_owner:change-me@localhost:5432/app_meta

# --- MCP server (read by mcp-server/mcp_sql_server/config.py) ---
# Connects as mcp_app, so the password must match MCP_APP_PASSWORD above.
MCP_APP_META_URL=postgresql+asyncpg://mcp_app:change-me@localhost:5432/app_meta
# Comma-separated Fernet keys; the first one encrypts, all of them can decrypt (key rotation).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_CONNECTION_SECRET_KEYS=change-me
# Optional: cache permissions and schema lookups (leave unset to run without caching).
# Use the same password as REDIS_PASSWORD above.
# MCP_REDIS_URL=redis://:change-me@localhost:6379/0
# Who the local stdio transport acts as (stdio has no login). Required to use stdio.
# HTTP transport + OAuth 2.1 (python -m mcp_sql_server --transport http)
# MCP_PUBLIC_URL=https://localhost/mcp
# MCP_OAUTH_ISSUER=https://localhost/auth/realms/sql-data-layer
# MCP_OAUTH_AUDIENCE=https://localhost/mcp
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8000
# Safety settings (all optional; the values shown are the defaults or an example).
# Extra Host / Origin header values the HTTP transport accepts, besides MCP_PUBLIC_URL. Origins
# are only needed for MCP clients that run inside a web page, such as the MCP Inspector.
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=
# Fair use per signed-in person: tool calls a minute, and calls running at once (0 = no limit).
# MCP_RATE_LIMIT_PER_MINUTE=120
# MCP_MAX_CONCURRENT_CALLS=4
# SQLite databases must live inside this folder. Without it, SQLite connections are refused.
# MCP_SQLITE_ROOT=/data
MCP_STDIO_SUB=dev-analyst
MCP_STDIO_NAME=Dev Analyst
MCP_STDIO_ROLES=analyst

# --- Admin GUI backend (read by gui-backend/gui_backend/config.py) ---
# Connects as gui_app, so the password must match GUI_APP_PASSWORD above.
GUI_APP_META_URL=postgresql+asyncpg://gui_app:change-me@localhost:5432/app_meta
# The SAME Fernet key(s) as MCP_CONNECTION_SECRET_KEYS.
GUI_CONNECTION_SECRET_KEYS=change-me
GUI_OAUTH_ISSUER=https://localhost/auth/realms/sql-data-layer
GUI_OAUTH_AUDIENCE=https://localhost/api
# GUI_REDIS_URL=redis://:change-me@localhost:6379/0
# GUI_CORS_ORIGINS=http://localhost:5173
# GUI_MCP_HEALTH_URL=http://localhost:8000/healthz

# --- Keycloak (identity provider; see deploy/keycloak) ---
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_PASSWORD=change-me
# Password for the sample users alice/bob/carol created by deploy/keycloak/bootstrap_dev.py (dev only).
KEYCLOAK_DEV_USER_PASSWORD=change-me

# --- Full stack (docker-compose.yml) ---
# The address people use to reach it. Leave as localhost to try it out; for a real deployment set
# your hostname and Caddy will obtain a certificate for it.
# PUBLIC_HOST=localhost
# Which database drivers the images include, besides PostgreSQL and SQLite. Add mssql for SQL
# Server (this also installs Microsoft's ODBC driver, which makes the image bigger).
# DB_DRIVERS=mysql,mssql
# Keycloak's own admin console is not served on the public address. Set this to true only while
# you need to manage users through it, and turn it off again afterwards.
# KEYCLOAK_EXPOSE_ADMIN=false
# Browser-based MCP clients allowed to call the server (comma-separated origins).
# MCP_ALLOWED_ORIGINS=
# Password of the `keycloak` database role (created on first start; keep it URL-safe).
KEYCLOAK_DB_PASSWORD=change-me

